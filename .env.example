# 企业微信机器人 webhook key
# 复制成 .env 后填入真实 key, .env 已被 .gitignore 排除, 不要提交
WECHAT_WEBHOOK_KEY=your-webhook-key-here

# 可选: pyecharts 静态资源服务地址, 默认 127.0.0.1:8888
# EASTMONEYRZRQ_ASSETS_HOST=127.0.0.1
# EASTMONEYRZRQ_ASSETS_PORT=8888

# 可选: 端口没起时是否允许临时自举一个静态资源服务, 默认允许 (1)
# 允许时, 程序会在同一个端口上临时起一个只读的本地静态服务, 流程结束自动关掉
# EASTMONEYRZRQ_ALLOW_TEMP_ASSETS_SERVER=1

# 可选: 自举服务用的本地资源目录 (应当包含 v5/echarts.min.js)
# 不设置时会依次找 ./pyecharts-assets/assets 与 ../pyecharts-assets/assets
# EASTMONEYRZRQ_ASSETS_DIR=C:/Users/LiJing/Desktop/jupyterlab/pyecharts-assets/assets
